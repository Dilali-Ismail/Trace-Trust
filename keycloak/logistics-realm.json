{
    "realm": "logistics-realm",
    "enabled": true,
    "registrationAllowed": true,
    "resetPasswordAllowed": true,
    "rememberMe": true,
    "verifyEmail": false,
    "accessTokenLifespan": 900,
    "ssoSessionIdleTimeout": 604800,
    "ssoSessionMaxLifespan": 2592000,
    "eventsEnabled": true,
    "eventsExpiration": 2592000,
    "eventsListeners": [
        "jboss-logging"
    ],
    "enabledEventTypes": [
        "LOGIN",
        "LOGIN_ERROR",
        "REGISTER",
        "LOGOUT"
    ]
}